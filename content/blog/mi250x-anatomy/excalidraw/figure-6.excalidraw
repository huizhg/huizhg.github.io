      "link": null,
      "locked": false,
      "text": "32-way conflict:\nthe same request\ntakes 32 passes",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 54,
      "containerId": null,
      "originalText": "32-way conflict:\nthe same request\ntakes 32 passes",
      "lineHeight": 1.25
    },
    {
      "id": "t207",
      "type": "text",
      "x": 40,
      "y": 650,
      "width": 844.8497314453125,
      "height": 20,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1781001315,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791231242145,
      "link": null,
      "locked": false,
      "text": "fix: pad each row to 33 floats, so a[33·i] lands in bank i mod 32 and the column read is one pass again",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "fix: pad each row to 33 floats, so a[33·i] lands in bank i mod 32 and the column read is one pass again",
      "lineHeight": 1.25
    },
