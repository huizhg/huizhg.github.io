      "updated": 1791231242146,
      "link": null,
      "locked": false,
      "text": "a 4-byte read by a wave64 runs in two phases (lanes 0–31, then 32–63); lanes reading the same address do not conflict",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "a 4-byte read by a wave64 runs in two phases (lanes 0–31, then 32–63); lanes reading the same address do not conflict",
