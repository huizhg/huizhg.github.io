      "text": "64 lanes × 16 registers = 1,024 values = the 32 × 32 C tile",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "64 lanes × 16 registers = 1,024 values = the 32 × 32 C tile",
      "lineHeight": 1.25
    },
    {
      "id": "t39",
      "type": "text",
      "x": 40,
      "y": 520,
      "width": 853.5535888671875,
      "height": 20,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1565962042,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791231486636,
      "link": null,
      "locked": false,
      "text": "a SIMD's matrix core peaks at 256 FP16 FLOPs per clock, so this instruction keeps it busy for 64 cycles;",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "a SIMD's matrix core peaks at 256 FP16 FLOPs per clock, so this instruction keeps it busy for 64 cycles;",
      "lineHeight": 1.25
    },
    {
      "id": "t40",
      "type": "text",
      "x": 40,
      "y": 546,
      "width": 919.009765625,
      "height": 20,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1276803430,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791231486637,
      "link": null,
      "locked": false,
      "text": "other vector and scalar instructions can issue during part of that time. 4 SIMDs = 1,024 FLOPs per clock per CU",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "other vector and scalar instructions can issue during part of that time. 4 SIMDs = 1,024 FLOPs per clock per CU",
      "lineHeight": 1.25
    },
