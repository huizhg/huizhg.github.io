      "isDeleted": false,
      "boundElements": null,
      "updated": 1791231242723,
      "link": null,
      "locked": false,
      "text": "each tall box is one 64 B line; the filled top is the 4 bytes its lane wanted",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 12,
      "containerId": null,
      "originalText": "each tall box is one 64 B line; the filled top is the 4 bytes its lane wanted",
      "lineHeight": 1.25
    },
    {
      "id": "t339",
      "type": "text",
      "x": 40,
      "y": 572,
      "width": 1045.10595703125,
      "height": 20,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
