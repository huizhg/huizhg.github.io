      "roundness": null,
      "seed": 1201473357,
      "version": 1,
      "versionNonce": 0,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1791231242723,
      "link": null,
      "locked": false,
      "text": "the vector L1 delivers 64 B per clock, so pattern B costs 16× the L1 time and moves 16× the data for the same 256 useful bytes",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "baseline": 14,
      "containerId": null,
      "originalText": "the vector L1 delivers 64 B per clock, so pattern B costs 16× the L1 time and moves 16× the data for the same 256 useful bytes",
      "lineHeight": 1.25
    },
