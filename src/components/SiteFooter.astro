---
import { site } from '../../content/site';

const year = new Date().getFullYear();
---

<footer class="column">
  <div class="site-footer">
    <span>© {year} {site.name}</span><span aria-hidden="true">·</span><span>{site.location}</span>
  </div>
</footer>

<style>
  .site-footer {
    padding: 32px 0 48px;
    border-top: 1px solid var(--rule);
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 24px;
    font-size: 15px;
    color: var(--muted);
  }
  @media (max-width: 640px) {
    .site-footer {
      gap: 12px;
    }
  }
</style>
