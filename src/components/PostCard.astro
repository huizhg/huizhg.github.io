---
import { formatDate, readingTime, type Post } from '../lib/posts';
import { site } from '../../content/site';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, date, draft } = post.data;
---

<a class="card" href={`/blog/${post.id}/`}>
  <h3 class="card-title">{title}</h3>
  <p class="card-desc">{description}</p>
  <p class="card-meta">
    <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time> · {readingTime(post.body)} min · {site.name}{draft && ' · Draft'}
  </p>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    padding: 28px 40px;
    background: var(--card);
    border-radius: 8px;
    color: var(--ink);
    text-align: center;
  }
  .card:hover {
    color: var(--ink);
    text-decoration: none;
  }
  .card:hover .card-title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }
  .card-title {
    margin: 0;
    font-family: var(--serif);
    font-size: 26px;
    font-weight: 500;
    line-height: 1.25;
  }
  .card-desc {
    margin: 0;
    font-size: 17px;
    line-height: 1.6;
    color: var(--ink-soft);
  }
  .card-meta {
    margin: 0;
    font-size: 14px;
    color: var(--muted);
  }
  @media (max-width: 640px) {
    .card {
      padding: 24px 20px;
    }
    .card-title {
      font-size: 22px;
    }
  }
</style>
